target/
*.class
*.so
*.dll
*.exe
*.a

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Testing and coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Gradle
.gradle/

# Python specific
*.pyo
*.pyd
*.egg-info/
.Python
pip-log.txt
pip-delete-this-directory.txt

# JavaScript/Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.jscsrc
.jshintrc
.npmrc
.node_repl_history
.cache/
.nyc_output/
coverage/
.nyc_output/

# Java specific
*.class
*.jar
*.war
*.ear
hs_err_pid*

# C/C++ specific
*.o
*.a
*.so
*.dll
*.exe
*.out
*.app
*.dylib

# Ruby specific
*.gem
*.rbc
.bundle/
vendor/bundle/
.rbenv-gemsets
.rbenv-version

# Go specific
*.o
*.a
*.swp
*~
.DS_Store
.svn/
CVS/
